<?xml version="1.0" encoding="utf-8"?>
<!--
  Only window and focus events are requested: enough to know when a keyboard
  is open and which text box to type into.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.offlinevoice.keyboard.MainActivity" />
